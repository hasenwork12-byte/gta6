# Copy to .env.local (local dev) or add in Vercel → Project → Settings → Environment Variables.
# Leave the addresses empty to run the site on clearly-labelled DEMO DATA.

# SPL token mint of the coin
NEXT_PUBLIC_TOKEN_MINT=
# Public treasury wallet that receives the creator fees
NEXT_PUBLIC_TREASURY_WALLET=

# Server-side RPC used for reading chain data. A Helius URL (with API key) is
# strongly recommended — the public endpoint is heavily rate-limited and
# usually blocks the holder count query.
#   https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Browser-side RPC used by the wallet adapter (only reads the connected address).
# Do not put a secret API key here — it is exposed to the browser.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# How many recent treasury transactions to scan for the ledger / fee totals
LEDGER_TX_LIMIT=60

# ── Points database (Upstash Redis) ─────────────────────────────────────────
# On Vercel: Storage → Marketplace → Upstash Redis → connect to this project.
# That sets KV_REST_API_URL and KV_REST_API_TOKEN automatically.
# Without it (or without a token mint), points run on an in-memory DEMO store.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Encrypts game codes before they're stored. Required once points are live.
# 32 random bytes, base64 — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it secret and never change it after adding codes (old codes couldn't be decrypted).
KEYS_ENCRYPTION_KEY=

# Secret for the admin page (/admin) — any random string, 16+ characters.
ADMIN_TOKEN=
# Vercel sets this automatically for cron jobs if you add it as an env var;
# the daily points snapshot (/api/cron/snapshot) requires it. 16+ characters.
CRON_SECRET=

# Force demo mode even when addresses are set (true/false)
NEXT_PUBLIC_FORCE_DEMO=false

# ── Fee bot (auto claim → buyback → burn → send to Pig Bank) ──────────────────
# The coin's creator wallet. Public address only; used to show fees waiting to be claimed.
# Leave empty if the Pig Bank wallet IS the creator wallet.
NEXT_PUBLIC_CREATOR_WALLET=
# SECRET key of the creator wallet, so the bot can claim and swap. Base58 (Phantom
# "Export private key") or a JSON byte array. Use a wallet made only for this,
# never your personal one. Only ever paste it into Vercel's env settings.
BOT_SECRET_KEY=
# Optional: free key from portal.jup.ag (higher Jupiter rate limit).
JUP_API_KEY=
# Optional tuning (SOL). Defaults shown.
# BOT_MIN_CLAIM_SOL=0.001     claim once this much is waiting (usepaid claims ~0.001 SOL)
# BOT_CLAIM_EVERY_SEC=105     at most one claim per 1m45s (usepaid's launch-day rhythm)
# BOT_GAS_RESERVE_SOL=0.02    always kept in the bot wallet for fees
# Run it EVERY MINUTE (that gives usepaid's ~2 min claim rhythm): add a free job on
# cron-job.org: GET https://paidingames.com/api/cron/bot, every 1 minute, with
# header  Authorization: Bearer <CRON_SECRET>. (Vercel's own cron is once a day only.)
